# Set your own local values before running. This file is safe to commit; .env is ignored.
DATABASE_PASSWORD=change-this-database-password
ARENA_ADMIN_USERNAME=host
ARENA_ADMIN_PASSWORD=change-this-admin-password

# Browser-facing API ports in docker-compose.yml
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws-arena
ALLOWED_ORIGIN_PATTERNS=http://localhost:3000
